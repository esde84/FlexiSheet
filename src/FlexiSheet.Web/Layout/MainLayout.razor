@inherits LayoutComponentBase
@inject WorkspaceState State
@inject FlexiSheet.Application.LoadWorkspace.Handler LoadWorkspace
@inject IJSRuntime Javascript
@inject ILogger<MainLayout> Logger
@inject NavigationManager Navigation

<a class="govuk-skip-link" href="@($"{Navigation.Uri.Split('#')[0]}#main-content")"
   @onclick="FocusMainAsync" @onclick:preventDefault>Skip to main content</a>
<header class="service-header">
    <div class="govuk-width-container">
        <a class="service-name" href="">FlexiSheet</a>
        <nav aria-label="Main navigation">
            <NavLink href="" Match="NavLinkMatch.All">Flexi periods</NavLink>
            <NavLink href="settings">Working pattern</NavLink>
            <NavLink href="backup">Backup and restore</NavLink>
        </nav>
    </div>
</header>
<div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content" tabindex="-1" @ref="mainContent">
        @if (loading)
        {
            <p class="govuk-body" role="status">Loading your flexi periods...</p>
        }
        else if (State.Current is null && !IsBackupPage)
        {
            <h1 class="govuk-heading-xl">Your data could not be opened</h1>
            <Messages Error="@State.Error" Success="@State.Success" />
            <p class="govuk-body">Your existing data has not been replaced. Do not clear browser data if you need to keep your records.</p>
            <p class="govuk-body"><a class="govuk-link" href="backup">Restore a backup</a> if you have a saved copy.</p>
            <button class="govuk-button" @onclick="InitializeAsync">Try again</button>
        }
        else
        {
            @Body
        }
    </main>
    <footer class="service-footer">
        <p class="govuk-body-s">FlexiSheet is not a government service. Data stays in this browser on this device.</p>
        <p class="govuk-body-s">Clearing browser data deletes your records. <a class="govuk-link" href="backup">Back up your data</a> regularly.</p>
        @if (persistenceNotice is not null)
        {
            <p class="govuk-body-s" role="status">@persistenceNotice</p>
        }
    </footer>
</div>

@code {
    private bool loading = true;
    private string? persistenceNotice;
    private ElementReference mainContent;
    private bool IsBackupPage => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0] == "backup";

    private async Task FocusMainAsync() => await mainContent.FocusAsync();

    protected override async Task OnInitializedAsync()
    {
        await InitializeAsync();
        try
        {
            if (!await Javascript.InvokeAsync<bool>("flexiSheetStorage.requestPersistence"))
                persistenceNotice = "The browser has not guaranteed persistent storage and may remove your data.";
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Persistent storage permission could not be requested");
            persistenceNotice = "Persistent storage permission could not be requested. Browser data may be removed.";
        }
    }

    private async Task InitializeAsync()
    {
        loading = true;
        await State.ExecuteAsync(LoadWorkspace.HandleAsync);
        loading = false;
    }
}
